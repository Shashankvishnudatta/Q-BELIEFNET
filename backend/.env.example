# Backend-only configuration. Keep real values in backend/.env and never commit them.
APP_NAME=Q-Belief Net API
APP_MODE=demo
DATA_MODE=demo
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional external market/social data providers.
RAPIDAPI_KEY=
RAPIDAPI_HOST=apidojo-yahoo-finance-v1.p.rapidapi.com
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=Q-Belief Net/1.0
STOCKTWITS_TOKEN=

# Optional processing infrastructure.
REDIS_URL=

# Optional backend-only LLM key. Do not expose this through VITE_ variables.
HF_API_KEY=
HF_MODEL_ID=meta-llama/Meta-Llama-3-8B-Instruct

# Evidence provider pipeline.
ENABLE_EVIDENCE_CACHE=true
EVIDENCE_CACHE_TTL_SECONDS=300
ALLOW_LIVE_MODE_DEMO_FALLBACK=false
ALLOW_STALE_CACHE_ON_PROVIDER_FAILURE=true
STALE_CACHE_MAX_AGE_SECONDS=1800
PROVIDER_TIMEOUT_SECONDS=8
PROVIDER_RETRY_COUNT=1
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_RESET_SECONDS=120
ENABLE_BACKGROUND_REFRESH=false
BACKGROUND_REFRESH_INTERVAL_SECONDS=60
BACKGROUND_REFRESH_SYMBOLS=AAPL,TSLA,NVDA,MSFT,AMZN

# Durable local persistence.
ENABLE_PERSISTENCE=true
DATABASE_URL=sqlite:///backend/data/qbeliefnet.db
PERSISTENCE_MODE=sqlite
MAX_SNAPSHOTS_PER_SYMBOL=100

# Local prototype operation guard.
ENABLE_MANUAL_REFRESH=true
MANUAL_REFRESH_TOKEN=
REQUIRE_MANUAL_REFRESH_TOKEN=false
MAX_MANUAL_REFRESH_SYMBOLS=10
